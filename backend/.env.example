# 合成数据生成工作台 — 后端环境变量示例
# 复制为 .env 并按需修改（.env 已被 .gitignore 忽略）

# libpq / SQLAlchemy 连接串，指向本地 PostgreSQL 测试目标
DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/synthdb

# 业务表所在 schema（工作台只读取/写入该 schema）
BUSINESS_SCHEMA=public

# 工作台私有记账 schema（批次表，不会被自省成业务表）
WORKBENCH_SCHEMA=synth

# Faker 语言环境（生成非真实姓名）
FAKER_LOCALE=zh_CN

SAMPLE_SIZE=10
INSERT_BATCH_SIZE=200
